 group=by[n]['phuma_source']['source_group']
 directory=str(pathlib.PurePosixPath(group).parent)
 if r['split']=='train' and group.startswith('GRAB/') and directory in grab_heldout:
  removed.append({'clip':n,'source_group':group,'directory_candidate':directory,'saved_duration_s_from_check':r['duration_s'],'bucket':by[n]['bucket'],'in_original_R02_train':n in oc['split_clips']['train'],'source_sha256':by[n]['phuma_source']['sha256']})
