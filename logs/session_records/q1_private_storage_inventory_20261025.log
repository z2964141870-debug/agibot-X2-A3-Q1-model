ssh -T -p 18864 -o BatchMode=yes -o ConnectTimeout=8 -o ConnectionAttempts=1 -o 'HostKeyAlias=[59.77.15.15]:25893' root@127.0.0.1 'env PYTHONDONTWRITEBYTECODE=1 python3 -B -' <<'Q1_DUPLICATE_AUDIT'
import collections, datetime, hashlib, json, os, pathlib, stat, time
base=pathlib.Path("/opt/data/private")
roots=[base/"YuanQi_Q1",base/"yuanqi_ops",base/"hechengzhu/ZHY"]
start=time.time()
cutoff=datetime.datetime(2026,10,25,8,tzinfo=datetime.timezone(datetime.timedelta(hours=8))).timestamp()
byroot={}
groups=collections.defaultdict(list)
errors=[]
for root in roots:
    bins=collections.defaultdict(lambda:[0,0])
    inodes=set()
    recent=[]
    count=0
    for parent,dirs,files in os.walk(root,followlinks=False):
        for name in files:
            path=pathlib.Path(parent)/name
            try:
                s=path.lstat()
                if not stat.S_ISREG(s.st_mode):
                    continue
                count+=1
                ident=(s.st_dev,s.st_ino)
                ext=path.suffix.lower() or "<none>"
                if ident not in inodes:
                    bins[ext][0]+=s.st_blocks*512
                    bins[ext][1]+=1
                    inodes.add(ident)
                if s.st_size>=64*1024**2:
                    groups[(name,s.st_size)].append({"path":str(path),"root":str(root),"size":s.st_size,
                        "allocated":s.st_blocks*512,"dev":s.st_dev,"inode":s.st_ino,"nlink":s.st_nlink})
                if s.st_mtime>=cutoff and s.st_blocks*512>=1024**2:
                    recent.append({"path":str(path),"allocated":s.st_blocks*512,"mtime_ns":s.st_mtime_ns})
            except OSError as e:
                errors.append(str(e))
    byroot[str(root)]={"regular_files":count,"unique_inodes":len(inodes),
        "allocated_regular_bytes":sum(v[0] for v in bins.values()),
        "extensions":sorted([{"suffix":k,"allocated":v[0],"files":v[1]} for k,v in bins.items()],key=lambda r:r["allocated"],reverse=True)[:12],
        "mtime_since_0800_files_at_least_1MiB":len(recent),
        "mtime_since_0800_allocated_at_least_1MiB_bytes":sum(r["allocated"] for r in recent),
        "recent_largest":sorted(recent,key=lambda r:r["allocated"],reverse=True)[:8]}
candidates=[]
for key,rows in sorted(groups.items(),key=lambda kv:kv[0][1],reverse=True):
    if len({r["root"] for r in rows})>=2:
        candidates.append({"name":key[0],"size":key[1],"files":rows})
verified=[]
budget=2*1024**3
for group in candidates:
    distinct={}
    for r in group["files"]:
        distinct.setdefault((r["dev"],r["inode"]),r)
    bytes_needed=sum(r["size"] for r in distinct.values())
    if bytes_needed>budget:
        continue
    shas=[]
    for r in distinct.values():
        h=hashlib.sha256()
        with open(r["path"],"rb") as f:
            for chunk in iter(lambda:f.read(8*1024**2),b""):
                h.update(chunk)
        shas.append({"path":r["path"],"sha256":h.hexdigest(),"size":r["size"]})
    budget-=bytes_needed
    verified.append({"name":group["name"],"same_content":len({r["sha256"] for r in shas})==1,
        "distinct_inodes":len(distinct),"files":shas})
    if len(verified)>=3:
        break
print(json.dumps({"status":"READ_ONLY_OWNED_PROJECT_METADATA_AND_BOUNDED_DUPLICATE_CHECK",
 "time_beijing":datetime.datetime.now(datetime.timezone(datetime.timedelta(hours=8))).isoformat(),
 "roots":byroot,"cross_root_same_name_size_candidates_at_least_64MiB_count":len(candidates),
 "cross_root_candidates":candidates[:20],"bounded_full_sha256_verification":verified,
 "full_hash_bytes_budget":2*1024**3,"full_hash_bytes_read":2*1024**3-budget,
 "errors":errors,"elapsed_seconds":time.time()-start},ensure_ascii=True,sort_keys=True))

