# Root content is intentional: only the four project directories and governance.
/*
!/.gitignore
!/README.md
!/AGENTS.md
!/data/
!/logs/
!/script/
!/reports/

# Generated data and source excerpts stay local; small manifests are versioned.
/data/*
!/data/README.md
!/data/manifests/
/data/manifests/*
!/data/manifests/README.md
!/data/manifests/*.json
!/data/manifests/*.jsonl
!/data/manifests/*.csv
!/data/manifests/*.tsv

# Opt in compact, reviewed command transcripts only.
/logs/*
!/logs/README.md
!/logs/session_records/
/logs/session_records/*
!/logs/session_records/*.log
!/logs/session_records/*.txt
!/logs/session_records/*.json
!/logs/session_records/*.md

**/__pycache__/
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/.venv/
**/venv/
**/node_modules/
**/wandb/
**/runs/
**/.DS_Store
**/.env
**/.env.*
**/*credentials*
**/*cookies*
**/id_rsa*
**/id_ed25519*
*.pyc
*.pyo
*.pt
*.pth
*.ckpt
*.onnx
*.safetensors
*.pkl
*.pickle
*.npy
*.npz
*.bag
*.mcap
*.mp4
*.mov
*.zip
*.tar
*.tar.gz
*.tgz
*.7z
*.rar
