feet=[np.array([gid for gid in assets.foot_geoms if model.geom_bodyid[gid]==model.body(side+'_ankle_roll_link').id]) for side in ('left','right')]
results=[]
for row in report['rows']:
 with np.load(row['prior_arrays']['path'],allow_pickle=False) as a:
