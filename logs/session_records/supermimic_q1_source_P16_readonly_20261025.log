paths=[lib/'references/manifest.json',lib/'reference_check.json',old/'completion.json',old/'references/manifest.json',old/'reference_check.json']
def identity(p):
 b=p.read_bytes();return {'path':str(p),'bytes':len(b),'sha256':hashlib.sha256(b).hexdigest()}
before=[identity(p) for p in paths]
assert [r['sha256'] for r in before[:3]]==['8e3b97685f04d01ab2c1907f8a1d868eadde87e9ffbf5007d810ec9589540ec6','24fbc53eb032135cbba336e25ec10edad53601011ee05bc8f67dafd172644d69','e5e9d54cea83f02f4e9c850c140ac0ea48b20faf7c1a14799a5d5deb7182693e']
