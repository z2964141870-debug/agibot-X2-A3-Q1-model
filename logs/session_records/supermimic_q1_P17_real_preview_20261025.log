output=base/'PHUMA_P17_directory_excluded_library_20261025'
assert not path.exists() and not output.exists()
args=types.SimpleNamespace(root=root,library=base/'PHUMA_P08B_subject_excluded_library_V2_20261025',source_aliases=base/'SOURCE_P08B_aliases_20261025/receipt.json',walking_holdout=base/'PHUMA_P10_walking_selection_20261025.json',expected_oom_kill=14,preview=True,output=None)
