import pathlib,json,hashlib,subprocess,datetime
from PIL import Image
root=pathlib.Path('/opt/data/private/YuanQi_Q1/data/supermimic_for_q1/V02_R03_final_20261024')
def identity(p):
 p=pathlib.Path(p);return {'path':str(p),'bytes':p.stat().st_size,'sha256':hashlib.sha256(p.read_bytes()).hexdigest()}
rows=[];documents={};images=[]
for name,expected in [('walk',826),('squat',579),('punch',339)]:
 directory=root/('render_'+name)
 receipt_path=directory/'receipt.json';audit_path=directory/'audited_render.json'
 receipt=json.loads(receipt_path.read_text());audit=json.loads(audit_path.read_text())
 assert receipt['status']=='SAVED_TRACE_RENDER_COMPLETED'
 assert audit['status']=='AUDITED_SAVED_TRACE_RENDER_COMPLETED'
 assert audit['render_receipt']==identity(receipt_path)
 assert receipt['rendered_frames']==expected==audit['rendered_frames_expected']
 assert all(identity(item['path'])==item for item in receipt['artifacts'])
 video=directory/'comparison.mp4'
 probe=json.loads(subprocess.check_output(['ffprobe','-v','error','-count_frames','-select_streams','v:0','-show_entries','stream=width,height,r_frame_rate,avg_frame_rate,nb_read_frames,nb_frames,duration:format=duration','-of','json',str(video)],text=True))
 stream,=probe['streams']
 assert int(stream['nb_read_frames'])==expected
 assert (stream['width'],stream['height'])==(1280,548)
 assert stream['r_frame_rate']=='25/1'
 assert abs(float(probe['format']['duration'])-expected/25)<0.001
 pngs=sorted(directory.glob('frame_*.png'));assert len(pngs)==3
 assert all(Image.open(p).size==(1280,548) for p in pngs)
 assert len({identity(p)['sha256'] for p in pngs})==3
 images.append([Image.open(p).convert('RGB').resize((640,274)) for p in pngs])
 rows.append({'motion':name,'render_receipt':identity(receipt_path),'audit':identity(audit_path),'video':identity(video),'ffprobe':probe,'screenshots':[identity(p) for p in pngs],'pixel_std_min':receipt['pixel_std_min'],'checks_passed':True})
 documents[name]={'render':receipt,'audited_render':audit}
sheet=Image.new('RGB',(1920,822),'white')
for row,panels in enumerate(images):
 for col,panel in enumerate(panels):sheet.paste(panel,(col*640,row*274))
sheet_path=root/'contact_sheet.png';assert not sheet_path.exists();sheet.save(sheet_path)
result={'status':'R03_V02_RENDER_FILES_VERIFIED','utc':datetime.datetime.now(datetime.timezone.utc).isoformat(),'rows':rows,'documents':documents,'contact_sheet':identity(sheet_path),'new_physics_steps':0,'new_policy_inference':0,'new_optimizer_updates':0,'browser_playback_verified':False,'human_visual_review_complete':False,'storage_status':'LOCAL_ONLY'}
print(json.dumps(result,separators=(',',':'),allow_nan=False))


