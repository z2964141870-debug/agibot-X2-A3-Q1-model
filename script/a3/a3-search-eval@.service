[Unit]
Description=YUANQI A3 conservative selected20 evaluation %i
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=/media/yu/FAFF-E9771/YUANQI_A3
ExecStart=/media/yu/FAFF-E9771/YUANQI_A3/data/environments/a3-sonic/bin/python -m script.a3.search_trial evaluate --trial %i
CPUQuota=100%
Environment=OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1
Restart=on-failure
RestartPreventExitStatus=1 2
RestartSec=30
TimeoutStopSec=60
KillMode=control-group

[Install]
WantedBy=default.target
