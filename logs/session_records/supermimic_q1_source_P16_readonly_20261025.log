by={r['clip']:r for r in m['motions']}
accepted={r['clip']:r for r in c['clips'] if r['qualified_for_training_pilot']}
assert len(accepted)==625 and set(accepted)==set(c['qualified_clips'])
oldnames={n for s,v in oc['split_clips'].items() for n in v}
