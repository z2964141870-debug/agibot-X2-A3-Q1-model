import collections
import datetime
import json
import os
import pathlib
import stat
import subprocess
import time

BASE = pathlib.Path("/opt/data/private")
OWNED = [BASE / "YuanQi_Q1", BASE / "yuanqi_ops", BASE / "hechengzhu/ZHY"]
START = time.time()
def now():
    return datetime.datetime.now(datetime.timezone(datetime.timedelta(hours=8))).isoformat()
def fs_state():
    v = os.statvfs(BASE)
    return {"time_beijing": now(), "total_bytes": v.f_blocks * v.f_frsize,
            "used_bytes": (v.f_blocks-v.f_bfree)*v.f_frsize,
            "free_including_reserved_bytes": v.f_bfree*v.f_frsize,
            "available_bytes": max(0, v.f_bavail)*v.f_frsize}
def run(args, timeout=90):
    p = subprocess.run(args, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, timeout=timeout)
    return {"command": args, "returncode": p.returncode, "stdout": p.stdout, "stderr": p.stderr}
result = {"status": "READ_ONLY_STORAGE_INVENTORY", "start": fs_state(),
          "server_files_created": 0, "server_files_deleted": 0,
          "scope": "Private tree metadata; no follow of symlinks; no reading credential or model contents."}
mounts = json.loads(run(["findmnt", "-J", "-o", "TARGET,SOURCE,FSTYPE,FSROOT"])["stdout"])
flat = []
def flatten(rows):
    for r in rows:
        if str(r.get("target", "")).startswith("/opt/data") or str(r.get("source", "")).startswith("/dev/nvme2n1p1"):
            flat.append({k: r.get(k) for k in ("target", "source", "fstype", "fsroot")})
        flatten(r.get("children", []))
flatten(mounts["filesystems"])
result["relevant_mounts"] = flat
top = []
for p in sorted(BASE.iterdir()):
    s = p.lstat()
    top.append({"path":str(p), "kind":"symlink" if stat.S_ISLNK(s.st_mode) else "directory" if stat.S_ISDIR(s.st_mode) else "file",
                "dev":s.st_dev, "inode":s.st_ino, "nlink":s.st_nlink, "mtime_ns":s.st_mtime_ns,
                "realpath":str(p.resolve())})
result["top_entries"] = top
paths = [
    BASE / "yuanqi_ops/data/training",
    BASE / "yuanqi_ops/data/humanplus_preview",
    BASE / "yuanqi_ops/script/amass_bridge/data",
    BASE / "yuanqi_ops/data/phuma",
    BASE / "hechengzhu/ZHY/data",
    BASE / "YuanQi_Q1/data/supermimic_for_q1",
    BASE / "YuanQi_Q1/data/references",
]
result["breakdowns"] = []
for path in paths:
    if path.is_dir():
        r = run(["ionice","-c","3","nice","-n","15","du","-x","-B1","--max-depth=1",str(path)])
        result["breakdowns"].append(r)
large = []
link_counts = collections.Counter()
links = []
errors = []
for root in OWNED:
    for parent, dirs, files in os.walk(root, followlinks=False, onerror=lambda e: errors.append(str(e))):
        for name in dirs + files:
            p = pathlib.Path(parent) / name
            try:
                s = p.lstat()
                if stat.S_ISLNK(s.st_mode):
                    link_counts[str(root)] += 1
                    if "/data/references/" in str(p) or (len(p.relative_to(root).parts) <= 3 and len(links) < 60):
                        links.append({"path":str(p),"target":os.readlink(p),"realpath":str(p.resolve()),"exists":p.exists()})
                elif stat.S_ISREG(s.st_mode) and s.st_size >= 1024**3:
                    large.append({"path":str(p),"root":str(root),"size":s.st_size,"allocated":s.st_blocks*512,
                                  "dev":s.st_dev,"inode":s.st_ino,"nlink":s.st_nlink,"mtime_ns":s.st_mtime_ns})
            except OSError as e:
                errors.append(str(e))
result["large_files_count_at_least_1GiB"] = len(large)
result["largest_files"] = sorted(large,key=lambda r:r["allocated"],reverse=True)[:40]
result["recent_large_files_since_0800_beijing"] = sorted(
    [r for r in large if r["mtime_ns"]/1e9 >= datetime.datetime(2026,10,25,8,tzinfo=datetime.timezone(datetime.timedelta(hours=8))).timestamp()],
    key=lambda r:r["mtime_ns"],reverse=True)[:30]
groups = collections.defaultdict(list)
for r in large:
    groups[(pathlib.Path(r["path"]).name,r["size"])].append(r)
result["same_name_size_candidates_not_content_verified"] = [
    {"name":key[0],"size":key[1],"paths":[r["path"] for r in rs],
     "distinct_inodes":len({(r["dev"],r["inode"]) for r in rs})}
    for key,rs in sorted(groups.items(),key=lambda kv:kv[0][1],reverse=True)
    if len({r["root"] for r in rs})>1
][:30]
result["symlink_counts"] = dict(link_counts)
result["reference_and_shallow_symlinks"] = links[:80]
result["walk_errors"] = errors
device = BASE.stat().st_dev
deleted = {}
proc_errors = 0
for proc in pathlib.Path("/proc").iterdir():
    if not proc.name.isdigit():
        continue
    try:
        for fd in (proc/"fd").iterdir():
            try:
                s=fd.stat()
                if s.st_dev==device and stat.S_ISREG(s.st_mode) and s.st_nlink==0:
                    key=(s.st_dev,s.st_ino)
                    row=deleted.setdefault(key,{"size":s.st_size,"allocated":s.st_blocks*512,
                        "path":os.readlink(fd),"pids":[]})
                    if int(proc.name) not in row["pids"]:
                        row["pids"].append(int(proc.name))
            except (FileNotFoundError,ProcessLookupError):
                pass
            except PermissionError:
                proc_errors+=1
    except (FileNotFoundError,ProcessLookupError):
        pass
    except PermissionError:
        proc_errors+=1
result["visible_deleted_open_files_same_device"] = list(deleted.values())
result["visible_deleted_open_allocated_bytes"] = sum(r["allocated"] for r in deleted.values())
result["proc_permission_errors"] = proc_errors
result["end"] = fs_state()
result["elapsed_seconds"] = time.time()-START
print(json.dumps(result,ensure_ascii=True,sort_keys=True))

